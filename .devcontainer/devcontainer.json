{
  "name": "ReadYou",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  
  "onCreateCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/setup-dependencies.sh\" && bash \"${containerWorkspaceFolder}/.devcontainer/setup-android.sh\"",
  "postCreateCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/setup-copilot.sh\" && curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github"
      ]
    }
  },
  "remoteEnv": {
    "OPENROUTER_API_KEY": "${localEnv:OPENROUTER_API_KEY}",
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk",
    "JAVA_HOME": "/usr/lib/jvm/java-17-openjdk-amd64",
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin:/home/vscode/.opencode/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools"
  },
  "features": {
    "ghcr.io/devcontainers/features/android-sdk:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  }
}
